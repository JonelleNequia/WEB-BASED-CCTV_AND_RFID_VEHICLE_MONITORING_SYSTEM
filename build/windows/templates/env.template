# PHILCST Vehicle Monitoring - settings of this install.
# Written once by the installer from build/windows/templates/env.template;
# an update keeps this file. APP_KEY encrypts the camera passwords: keep it
# (backups include it).
APP_NAME="PHILCST Vehicle Monitoring"
APP_ENV=production
APP_KEY={{APP_KEY}}
APP_DEBUG=false
# How the detector and the device service reach the web app on this PC.
APP_URL=http://127.0.0.1:{{WEB_PORT}}
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=sqlite
DB_DATABASE={{DATABASE}}

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# No queued jobs in this app: work runs inside the request (no queue worker service).
QUEUE_CONNECTION=sync
CACHE_STORE=database
MAIL_MAILER=log

# Shared key of the detector and device service (sent as X-Api-Key).
DETECTOR_API_KEY={{API_KEY}}
DETECTOR_STREAM_HOST=127.0.0.1
DETECTOR_STREAM_PORT=8765
# The web server passes /detector/... (basic live view) to the detector for signed-in users.
DETECTOR_STREAM_PROXY=true
DETECTOR_PYTHON={{PYTHON}}
GO2RTC_WEBRTC_PORT=8555

# Windows services run the detector, device service and live view.
MONITORING_SERVICES=managed
