[PHP]
engine=On
expose_php=Off
memory_limit=512M
max_execution_time=60
post_max_size=32M
upload_max_filesize=20M
default_charset="UTF-8"
display_errors=Off
log_errors=On
error_log="{{SHARED}}/logs/php-errors.log"
zend.exception_ignore_args=On
zend_extension="{{RELEASE}}/runtime/php/lib/opcache.so"
openssl.cafile="{{RELEASE}}/runtime/python/lib/python3.12/site-packages/certifi/cacert.pem"
curl.cainfo="{{RELEASE}}/runtime/python/lib/python3.12/site-packages/certifi/cacert.pem"
[Date]
date.timezone=Asia/Manila
[Session]
session.save_path="{{SHARED}}/storage/framework/sessions"
[opcache]
opcache.enable=1
opcache.enable_cli=0
