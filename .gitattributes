* text=auto eol=lf

# Windows install kit: Windows scripts need CRLF (cmd.exe misreads labels
# and long lines in LF batch files).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
# Windows install kit: what the release ZIP leaves out (git archive).
/tests export-ignore
/build export-ignore
/phpunit.xml export-ignore
/school-vehicle-monitoring-detector/tests export-ignore
/storage/backups export-ignore
/public/camera export-ignore
__pycache__ export-ignore
*.pyc export-ignore
*.pt export-ignore
/tools/go2rtc/*.zip export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
