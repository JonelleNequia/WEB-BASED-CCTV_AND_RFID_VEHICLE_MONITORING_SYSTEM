* text=auto eol=lf

# Windows install kit: Windows scripts need CRLF (cmd.exe misreads labels
# and long lines in LF batch files).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
# Windows install kit: what the release ZIP leaves out (git archive).
/tests export-ignore
/database/factories export-ignore
/build export-ignore
/phpunit.xml export-ignore
/school-vehicle-monitoring-detector/tests export-ignore
/storage/backups export-ignore
/.env export-ignore
/.env.backup export-ignore
/.env.production export-ignore
*.sqlite export-ignore
*.sqlite-wal export-ignore
*.sqlite-shm export-ignore
*.db export-ignore
*.sql export-ignore
**/first-admin.txt export-ignore
**/install-result.txt export-ignore
**/install.json export-ignore
/bootstrap/cache/*.php export-ignore
/storage/app/camera export-ignore
/storage/app/devices export-ignore
/storage/app/go2rtc export-ignore
/storage/framework/sessions/* export-ignore
/storage/framework/sessions/.gitignore -export-ignore
/storage/logs/* export-ignore
/storage/logs/.gitignore -export-ignore
/public/camera export-ignore
__pycache__ export-ignore
*.pyc export-ignore
*.pt export-ignore
/tools/go2rtc/*.zip export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
