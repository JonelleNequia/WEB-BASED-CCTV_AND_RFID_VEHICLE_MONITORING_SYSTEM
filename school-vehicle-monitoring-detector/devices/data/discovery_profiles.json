{
    "_about": "Editable data for automatic device detection. The code never names a device IP, subnet or port: everything it probes comes from this file or from the OS at runtime. Add a port, a discovery packet or a camera stream path here instead of changing code.",
    "scan": {
        "network_poll_seconds": 3,
        "network_settle_seconds": 4,
        "periodic_scan_seconds": 120,
        "device_lost_rescan_min_seconds": 30,
        "max_hosts_per_interface": 1024,
        "max_concurrency": 128,
        "connect_timeout_seconds": 0.7,
        "arp_settle_seconds": 2.0,
        "arp_trigger_port": 9,
        "udp_reply_seconds": 2.5,
        "reader_passive_listen_seconds": 1.5,
        "reader_reply_timeout_seconds": 0.8,
        "http_banner_ports": [
            80,
            8080
        ],
        "ignore_interface_patterns": [
            "^lo\\d*$",
            "^gif",
            "^stf",
            "^anpi",
            "^ap\\d",
            "^awdl",
            "^llw",
            "^utun",
            "^bridge",
            "^vboxnet",
            "^docker",
            "^veth",
            "^virbr",
            "vEthernet",
            "VMware",
            "VirtualBox",
            "Hyper-V",
            "Loopback",
            "Tailscale",
            "ZeroTier",
            "Bluetooth",
            "Thunderbolt Bridge"
        ],
        "wifi_interface_patterns": [
            "wi-?fi",
            "wlan",
            "wireless",
            "airport",
            "802\\.11"
        ],
        "wired_interface_patterns": [
            "ethernet",
            "\\blan\\b",
            "local area connection",
            "usb",
            "^eth\\d",
            "^en[ops]",
            "realtek",
            "ax88179",
            "gigabit"
        ]
    },
    "temporary_ip": {
        "enabled": true,
        "_note": "Used only when the service runs with admin rights and a device answered from another subnet (or a direct cable has only a 169.254 address). The address is removed right after the scan."
    },
